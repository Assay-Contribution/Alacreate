VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never prefix with VITE_ or it will be bundled into the browser code.
API_KEY=your-openai-key

# Server-only: lets background file processing write to Supabase. Bypasses Row Level
# Security, so never prefix with VITE_ and never use it in src/ai/mcp/ tools.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
