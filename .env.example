VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never prefix with VITE_ or it will be bundled into the browser code.
API_KEY=your-openai-key

# Server-only: lets background file processing write to Supabase. Bypasses Row Level
# Security, so never prefix with VITE_ and never use it in src/ai/mcp/ tools.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only OAuth app credentials for the integrations (see src/ai/endpoints/integrations.server.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
GROUPME_CLIENT_ID=

# Server-only: signs the short-lived cookie that ties an OAuth callback to the user who
# started it. Any long random string (e.g. `openssl rand -hex 32`).
OAUTH_STATE_SECRET=
# Optional: the site's public URL (e.g. https://yourdomain.com). Pins the OAuth redirect URIs
# so Vercel preview deployments use the same ones; defaults to each request's own origin.
APP_URL=
